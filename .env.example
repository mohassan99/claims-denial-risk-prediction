# Copy to .env (or run `bash scripts/make_env.sh`, which prompts for each value).
# .env is gitignored. See docs/LOCAL_SETUP.md for where each value comes from.

# Azure (deploy/deploy.sh). IDs are on the Azure portal's subscription and Entra overview pages.
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=rg-claims-denial
AZURE_ML_WORKSPACE=mlw-claims-denial
AZURE_LOCATION=canadacentral
# optional: service principal scoped to the resource group (headless / cloud-sandbox logins)
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Databricks Free Edition (databricks/). Token = personal access token.
DATABRICKS_HOST=https://dbc-f8758ffb-8443.cloud.databricks.com
DATABRICKS_TOKEN=

# Phase 4 agentic claim explainer (Anthropic API)
ANTHROPIC_API_KEY=
